name: Actualizar EPG Ecuador

on:
  workflow_dispatch:

  # Ecuador continental usa UTC-5 durante todo el año.
  # 09:17 UTC = 04:17 Ecuador.
  # 21:17 UTC = 16:17 Ecuador.
  schedule:
    - cron: "17 9,21 * * *"

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: github-pages-epg
  cancel-in-progress: false

env:
  # Generador estable previo a la corrección horaria. El commit es inmutable.
  BASE_GENERATOR_COMMIT: "5a0e7c59d94e8fc20ad83237727b1a49a6246248"

jobs:
  build:
    name: Generar y publicar EPG
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Descargar repositorio
        uses: actions/checkout@v6
        with:
          fetch-depth: 0

      - name: Configurar Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.13"
          cache: pip

      - name: Instalar dependencias
        shell: bash
        run: |
          set -euo pipefail
          python -m pip install --upgrade pip
          python -m pip install -r requirements.txt

      - name: Recuperar generador base estable
        shell: bash
        run: |
          set -euo pipefail

          BASE_URL="https://raw.githubusercontent.com/${GITHUB_REPOSITORY}/${BASE_GENERATOR_COMMIT}/scripts/build_epg.py"
          curl \
            --fail \
            --location \
            --silent \
            --show-error \
            --retry 4 \
            --retry-all-errors \
            --retry-delay 5 \
            "${BASE_URL}" \
            --output scripts/build_epg_base.py

          test -s scripts/build_epg_base.py
          grep -q 'def parse_mitv_page' scripts/build_epg_base.py
          grep -q 'def scrape_mitv_range' scripts/build_epg_base.py
          grep -q 'Canal.CNN.en.Español.ec' scripts/build_epg_base.py
          grep -q 'NTN24.co' scripts/build_epg_base.py
          python -m py_compile scripts/build_epg_base.py scripts/build_epg.py

      - name: Preparar directorio público
        shell: bash
        run: |
          set -euo pipefail
          rm -rf public
          mkdir -p public

      - name: Descargar XMLTV DTD
        shell: bash
        run: |
          set -euo pipefail

          curl \
            --fail \
            --location \
            --silent \
            --show-error \
            --retry 4 \
            --retry-all-errors \
            --retry-delay 5 \
            https://raw.githubusercontent.com/XMLTV/xmltv/master/xmltv.dtd \
            --output public/xmltv.dtd

          test -s public/xmltv.dtd

      - name: Validar conversión horaria de mi.tv
        shell: bash
        run: |
          set -euo pipefail
          python scripts/build_epg.py --self-test

      - name: Construir guía combinada
        shell: bash
        env:
          TZ: America/Guayaquil
          GUIDE_DAYS: "7"
        run: |
          set -euo pipefail

          python scripts/build_epg.py \
            --output public \
            --dtd public/xmltv.dtd \
            --days "${GUIDE_DAYS}"

      - name: Validar archivos finales
        shell: bash
        run: |
          set -euo pipefail

          test -s public/ec.xml
          test -s public/ec.xml.gz
          test -s public/xmltv.dtd
          test -s public/status.json

          gzip -t public/ec.xml.gz
          cmp public/ec.xml <(gzip -dc public/ec.xml.gz)

          EXPECTED_HEADER_FILE="$(mktemp)"
          cat > "${EXPECTED_HEADER_FILE}" <<'EOF'
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE tv SYSTEM "xmltv.dtd">

          <tv generator-info-name="none" generator-info-url="none">
          EOF

          head -n 4 public/ec.xml | diff -u "${EXPECTED_HEADER_FILE}" -

          grep -q '<channel id="TeleamazonasQuito.ec">' public/ec.xml
          grep -q '<channel id="TeleamazonasGuayaquil.ec">' public/ec.xml
          grep -q '<channel id="Ecuavisa.ec">' public/ec.xml
          grep -q '<channel id="EcuavisaInternacional.ec">' public/ec.xml
          grep -q '<channel id="TVC.ec">' public/ec.xml
          grep -q '<channel id="Canal.CNN.en.Español.ec">' public/ec.xml
          grep -q '<channel id="NTN24.co">' public/ec.xml

          grep -q 'channel="TeleamazonasQuito.ec"' public/ec.xml
          grep -q 'channel="TeleamazonasGuayaquil.ec"' public/ec.xml
          grep -q 'channel="Ecuavisa.ec"' public/ec.xml
          grep -q 'channel="EcuavisaInternacional.ec"' public/ec.xml
          grep -q 'channel="TVC.ec"' public/ec.xml
          grep -q 'channel="Canal.CNN.en.Español.ec"' public/ec.xml
          grep -q 'channel="NTN24.co"' public/ec.xml

          python - <<'PY'
          import json
          from pathlib import Path

          status = json.loads(Path("public/status.json").read_text(encoding="utf-8"))
          required = (
              "teleamazonas_quito",
              "teleamazonas_guayaquil",
              "ecuavisa",
              "ecuavisa_internacional",
              "tvc",
              "cnn_en_espanol",
              "ntn24",
          )
          for key in required:
              if int(status.get(key, 0)) <= 0:
                  raise SystemExit(f"Canal sin programación en status.json: {key}")

          if int(status.get("ecuavisa_internacional_days", 0)) <= 0:
              raise SystemExit("No se cargó ningún día de Ecuavisa Internacional.")
          if int(status.get("cnn_en_espanol_days", 0)) <= 0:
              raise SystemExit("No se cargó ningún día de CNN en Español desde mi.tv.")
          if int(status.get("ntn24_days", 0)) <= 0:
              raise SystemExit("No se cargó ningún día de NTN24 desde mi.tv.")
          PY

          echo "Cabecera:"
          head -n 4 public/ec.xml
          echo "Estado:"
          cat public/status.json
          echo "Tamaños:"
          du -h public/ec.xml public/ec.xml.gz public/xmltv.dtd

      - name: Configurar identidad Git
        shell: bash
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

      - name: Publicar copia Raw en rama epg-data
        shell: bash
        run: |
          set -euo pipefail

          RAW_PARENT="$(mktemp -d)"
          RAW_DIR="${RAW_PARENT}/epg-data"

          if git ls-remote --exit-code --heads origin epg-data >/dev/null 2>&1; then
            git worktree add -B epg-data "${RAW_DIR}" origin/epg-data
          else
            git worktree add --detach "${RAW_DIR}"
            (
              cd "${RAW_DIR}"
              git checkout --orphan epg-data
              git rm -rf . >/dev/null 2>&1 || true
            )
          fi

          cp public/ec.xml "${RAW_DIR}/ec.xml"
          cp public/ec.xml.gz "${RAW_DIR}/ec.xml.gz"
          cp public/xmltv.dtd "${RAW_DIR}/xmltv.dtd"
          cp public/status.json "${RAW_DIR}/status.json"

          cat > "${RAW_DIR}/README.md" <<'EOF'
          # EPG Ecuador — archivos generados

          Esta rama contiene la salida automática de la guía XMLTV.

          - `ec.xml`
          - `ec.xml.gz`
          - `xmltv.dtd`
          - `status.json`

          Incluye Teleamazonas Quito, Teleamazonas Guayaquil, Ecuavisa, Ecuavisa Internacional, TVC, CNN en Español y NTN24.
          EOF

          (
            cd "${RAW_DIR}"
            git add ec.xml ec.xml.gz xmltv.dtd status.json README.md

            if git diff --cached --quiet; then
              echo "La copia Raw no tiene cambios."
              exit 0
            fi

            git commit -m "Actualizar EPG Ecuador"
            git push origin HEAD:epg-data
          )

          git worktree remove "${RAW_DIR}" --force
          rm -rf "${RAW_PARENT}"

      - name: Configurar GitHub Pages
        uses: actions/configure-pages@v6

      - name: Preparar artefacto de Pages
        uses: actions/upload-pages-artifact@v5
        with:
          path: public

  deploy:
    name: Desplegar GitHub Pages
    needs: build
    runs-on: ubuntu-latest

    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    steps:
      - name: Publicar GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v5
